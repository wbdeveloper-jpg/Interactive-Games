    questionSprite: {fileID: 0}
    clueAudio: {fileID: 0}
    correctAudio: {fileID: 0}
  - questionId: Rainbow
    answer: Rainbow
    clue1: I appear after rain sometimes.
    clue2: I have many colors.
    clue3: You see me in the sky when sunlight bends through drops.
    manualWrongOptions:
    - Cloud
    - Lightning
    - Sunset
    questionSprite: {fileID: 0}
    clueAudio: {fileID: 0}
    correctAudio: {fileID: 0}
  - questionId: Train
    answer: Train
    clue1: I move on tracks.
    clue2: I can carry many people at once.
    clue3: I stop at stations.
    manualWrongOptions:
